PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/abco_hrms
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://127.0.0.1:5180
NODE_ENV=development
HOST=127.0.0.1
# Generate separate random 32-byte hex keys; retain them securely across deploys.
DOCUMENT_KEY=
BACKUP_KEY=
# Relative paths are resolved from backend when running the API.
DOCUMENT_STORAGE_PATH=storage/documents
# Optional password recovery and notification delivery. No email is sent without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public same-origin URL for recovery links (HTTPS in production).
# Set only after finance/operator verification described in docs/deployment.md.
BUSINESS_POLICY_APPROVED=NO
DEPLOYMENT_VERIFIED=NO
# Used only by npm run bootstrap. Choose your own credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
